{
  "manifest_version": 3,
  "name": "New Tab Container Picker",
  "version": "1.0.0",
  "description": "Choose a Firefox Multi-Account Container via a quick searchable popup whenever you open a new tab.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "new-tab-container-picker@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "cookies",
    "contextualIdentities",
    "storage"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "New Tab Container Picker (Enabled — click to pause)",
    "default_icon": {
      "32": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }
}
