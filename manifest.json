{
  "manifest_version": 3,
  "name": "New Tab Container Picker",
  "version": "1.0.0",
  "description": "Choose a Firefox Multi-Account Container via a quick searchable popup — triggered by keyboard shortcut, toolbar button, or optionally on every new tab.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "new-tab-container-picker@balaji.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "cookies",
    "contextualIdentities",
    "storage"
  ],
  "optional_permissions": [
    "tabs",
    "sessions"
  ],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "New Tab Container Picker",
    "default_popup": "src/picker/picker.html",
    "default_icon": {
      "32": "icons/icon.svg"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Open the container picker popup"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  }
}
